# Copy to backend/.env for running locally on your Mac (no Docker)
# Postgres.app uses your Mac username with no password
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/corysdollar
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Used only by `npm test` (it wipes this database each run)
TEST_DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/corysdollar_test
