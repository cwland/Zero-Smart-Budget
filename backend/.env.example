# Copy to backend/.env for running locally on your Mac (no Docker)
# Postgres.app uses your Mac username with no password
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/corysdollar
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Used only by `npm test` (it wipes this database each run)
TEST_DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/corysdollar_test

# Backups: daily automatic JSON backup (folder defaults to ./backups in the repo)
BACKUP_ENABLED=true
BACKUP_KEEP=30
# BACKUP_DIR=/path/to/backups

# Email: set it up in the app under Settings -> Email (recommended).
# These are only a fallback, used when nothing is saved in the app.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Cory's Dollar <you@gmail.com>"
# APP_URL=http://localhost:5173   # the address you open the app at (used in emailed links)
