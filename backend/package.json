{
  "name": "corys-dollar-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/run-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "reset-password": "tsx src/cli/reset-password.ts",
    "auth:reset": "tsx src/cli/auth-reset.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.10.1",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
