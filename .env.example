# Copy to .env and change these values
POSTGRES_USER=zerosmartbudget
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zerosmartbudget
DATABASE_URL=postgresql://zerosmartbudget:change-me@db:5432/zerosmartbudget

# API
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Web
WEB_PORT=5173

# Backups: daily automatic JSON backup (folder defaults to ./backups in the repo)
BACKUP_ENABLED=true
BACKUP_KEEP=30
# BACKUP_DIR=/path/to/backups
# Encrypts saved keys and passwords (AI keys, email password, Plaid secrets) inside backups.
# Without it, backups still include your settings but leave those out. Keep a copy somewhere
# safe: restoring on another server needs the same key. Make one: openssl rand -base64 32
# IMPORTANT: save this key somewhere safe, away from this server (a password manager).
# It can't be recovered; without it, the keys and passwords in your backups can't be restored.
# BACKUP_KEY=

# Release watcher: the bar at the top of the app when a newer release is published on GitHub.
# Checked after signing in and every UPDATE_CHECK_HOURS (0 = no schedule); turn it off in
# Settings -> Data -> Updates. While the repository is private, add a read-only token
# (fine-grained, this repo only, Contents: Read-only) so the server can see its releases.
# UPDATE_REPO=cwland/Zero-Smart-Budget
# UPDATE_CHECK_HOURS=3
# GITHUB_TOKEN=

# Email: set it up in the app under Settings -> Email (recommended).
# These are only a fallback, used when nothing is saved in the app.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Zero Smart Budget <you@gmail.com>"
# APP_URL=http://localhost:5173   # the address you open the app at (used in emailed links)

# Passkeys (sign in with Touch ID / Face ID / Windows Hello / a phone). They work on https://
# addresses and localhost, with no setup. Optional: only allow these addresses (comma-separated):
# PASSKEY_ORIGINS=https://budget.example.com

# OAuth sign-in is set up in the app (Settings > Sign-in). Locked out (provider down or
# misconfigured)? Set this to true and restart: password sign-in comes back and OAuth turns off.
# Remove it again once you're in. (Same as running: npm run auth:reset)
# EMERGENCY_DISABLE_OAUTH=true
